<odoo>
    <!-- WhatsApp Chat Dashboard -->
    <record id="view_whatsapp_chat_dashboard" model="ir.ui.view">
        <field name="name">whatsapp.chat.dashboard</field>
        <field name="model">whatsapp.chat</field>
        <field name="arch" type="xml">
            <kanban class="o_whatsapp_chat_dashboard" sample="1">
                <field name="name"/>
                <field name="unread_count"/>
                <field name="session_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_whatsapp_chat_card">
                            <div class="o_whatsapp_chat_header">
                                <div class="o_primary">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div t-if="record.unread_count.raw_value > 0" class="o_whatsapp_unread">
                                    <span class="badge badge-pill badge-success"><t t-esc="record.unread_count.value"/></span>
                                </div>
                            </div>
                            <div class="o_whatsapp_chat_preview">
                                <p class="text-muted">Click to open chat</p>
                            </div>
                            <div class="o_whatsapp_chat_footer">
                                <button name="open_chat" type="object" class="btn btn-sm btn-primary">
                                    <i class="fa fa-comment" title="Open Chat"/> Open
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- WhatsApp Message Tree View -->
    <record id="view_whatsapp_message_tree" model="ir.ui.view">
        <field name="name">whatsapp.message.tree</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Messages">
                <field name="date"/>
                <field name="direction"/>
                <field name="content"/>
                <field name="state"/>
                <field name="session_id"/>
                <field name="chat_id"/>
            </tree>
        </field>
    </record>
    
    <!-- WhatsApp Message Form View -->
    <record id="view_whatsapp_message_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Message">
                <sheet>
                    <group>
                        <group>
                            <field name="content"/>
                            <field name="date"/>
                            <field name="direction"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="session_id"/>
                            <field name="chat_id"/>
                            <field name="is_test"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- WhatsApp Chat Conversation View (custom) -->
    <record id="view_whatsapp_chat_conversation" model="ir.ui.view">
        <field name="name">whatsapp.chat.conversation</field>
        <field name="model">whatsapp.chat</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Conversation">
                <sheet>
                    <div class="o_whatsapp_conversation">
                        <!-- Chat Header -->
                        <div class="o_whatsapp_chat_header bg-primary text-white p-2">
                            <h3 class="m-0"><field name="name"/></h3>
                            <field name="session_id" invisible="1"/>
                        </div>
                        
                        <!-- Messages Area -->
                        <div class="o_whatsapp_messages_container p-2" style="height: 400px; overflow-y: auto; background-color: #f0f0f0;">
                            <!-- This would be populated by JavaScript in a real implementation -->
                            <field name="message_ids" invisible="1"/>
                            <div class="text-center py-5">
                                <i class="fa fa-comments fa-3x text-muted mb-2" title="Messages"></i>
                                <p class="text-muted">Messages will appear here</p>
                                <!-- <button name="load_messages" type="object" string="Load Test Messages" class="btn btn-secondary"/> -->
                            </div>
                        </div>
                        
                        <!-- Message Input -->
                        <div class="o_whatsapp_message_input p-2 bg-white border-top">
                            <div class="input-group">
                                <input type="text" name="message_text" class="form-control" placeholder="Type a message..."/>
                                <div class="input-group-append">
                                    <!-- <button type="object" class="btn btn-primary">
                                        <i class="fa fa-paper-plane" title="Send"/> Send
                                    </button> -->
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action for Chat Conversation -->
    <record id="action_whatsapp_chat_conversation" model="ir.actions.act_window">
        <field name="name">WhatsApp Conversation</field>
        <field name="res_model">whatsapp.chat</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_whatsapp_chat_conversation"/>
        <field name="target">current</field>
        <field name="context">{'default_is_test': True}</field>
    </record>
</odoo>