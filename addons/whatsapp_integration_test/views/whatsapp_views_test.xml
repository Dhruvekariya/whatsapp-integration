<odoo>
    <!-- Create a completely new form view compatible with Odoo 17.0 -->
    <record id="view_whatsapp_session_form_test" model="ir.ui.view">
        <field name="name">whatsapp.session.form.test</field>
        <field name="model">whatsapp.session</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Integration (Test)">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="generate_qr_code" type="object" string="Generate QR Code" 
                            invisible="state == 'connected'" class="btn-primary"/>
                    <button name="get_chat_list" type="object" string="Refresh Chats" 
                            invisible="state != 'connected'" class="btn-primary"/>
                    <button name="check_connection" type="object" string="Check Connection" 
                            invisible="state != 'connecting'" class="btn-secondary"/>
                    <button name="simulate_connection" type="object" string="Simulate Connection" 
                            invisible="state != 'connecting' or not test_mode" class="btn-success"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Session Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="last_connected"/>
                        </group>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="test_mode" invisible="0"/>
                        </group>
                    </group>
                    
                    <!-- New UI Layout with tabs -->
                    <notebook>
                        <!-- QR Code Tab -->
                        <page string="QR Code" invisible="state == 'connected'">
                            <div class="o_whatsapp_qr_container text-center">
                                <h3>Scan QR Code with WhatsApp Mobile App</h3>
                                <div class="oe_qr_big">
                                    <field name="qr_code_image" widget="image" class="oe_qr_big" options="{'preview_image': 'qr_code_image', 'size': [300, 300]}"/>
                                </div>
                                <div class="mt16 mb16">
                                    <p>1. Open WhatsApp on your phone</p>
                                    <p>2. Tap Menu or Settings and select WhatsApp Web</p>
                                    <p>3. Point your phone at this screen to scan the QR code</p>
                                </div>
                                <div class="mt16" invisible="not test_mode or state != 'connecting'">
                                    <div class="alert alert-info" role="alert">
                                        <p><strong>Test Mode Enabled:</strong> In test mode, you can use the "Simulate Connection" button in the header to simulate a successful connection.</p>
                                    </div>
                                </div>
                            </div>
                        </page>
                        
                        <!-- Chats Tab -->
                        <page string="Chats" invisible="state != 'connected'">
                            <field name="chat_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="unread_count"/>
                                    <button name="open_chat" type="object" string="Open" class="btn btn-primary btn-sm"/>
                                </tree>
                            </field>
                        </page>
                        
                        <!-- Chat Window Tab -->
                        <page string="Chat Window" invisible="state != 'connected'">
                            <div class="o_whatsapp_chat_window">
                                <!-- Chat Header -->
                                <div class="o_whatsapp_chat_header bg-light p-2 border-bottom">
                                    <h5 class="m-0">Selected Chat</h5>
                                </div>
                                
                                <!-- Messages Container -->
                                <div class="o_whatsapp_chat_messages p-2" style="height: 300px; overflow-y: auto;">
                                    <p class="text-center text-muted">Select a chat to view messages</p>
                                </div>
                                
                                <!-- Chat Input -->
                                <div class="o_whatsapp_chat_composer p-2 border-top">
                                    <div class="input-group">
                                        <input type="text" class="form-control" placeholder="Type a message"/>
                                        <div class="input-group-append">
                                            <button class="btn btn-primary">
                                                <i class="fa fa-paper-plane" title="Send message"/>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                        
                        <!-- Settings Tab -->
                        <page string="Settings">
                            <group>
                                <field name="session_id" string="WhatsApp Session ID"/>
                                <field name="user_id" string="Assigned User"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Simple action definition for Odoo 17 -->
    <record id="action_whatsapp_session_test" model="ir.actions.act_window">
        <field name="name">WhatsApp Sessions (Test)</field>
        <field name="res_model">whatsapp.session</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp test session.
            </p>
        </field>
    </record>
    
    <!-- Define a WhatsApp chat view -->
    <record id="view_whatsapp_chat_tree" model="ir.ui.view">
        <field name="name">whatsapp.chat.tree</field>
        <field name="model">whatsapp.chat</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Chats">
                <field name="name"/>
                <field name="unread_count"/>
                <field name="session_id"/>
                <button name="open_chat" type="object" string="Open Chat" class="btn btn-primary btn-sm"/>
            </tree>
        </field>
    </record>
    
    <!-- Define a WhatsApp chat form view -->
    <record id="view_whatsapp_chat_form" model="ir.ui.view">
        <field name="name">whatsapp.chat.form</field>
        <field name="model">whatsapp.chat</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Chat">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Chat Name"/></h1>
                    </div>
                    <group>
                        <field name="session_id"/>
                        <field name="unread_count"/>
                        <field name="is_favorite"/>
                    </group>
                    <!-- Placeholder for chat messages -->
                    <notebook>
                        <page string="Messages">
                            <p class="text-center text-muted p-3">
                                In a real implementation, messages would be displayed here.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Define an action for WhatsApp chats -->
    <record id="action_whatsapp_chat" model="ir.actions.act_window">
        <field name="name">WhatsApp Chats</field>
        <field name="res_model">whatsapp.chat</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No WhatsApp chats found. Connect WhatsApp first.
            </p>
        </field>
    </record>
    
    <!-- Test menu structure -->
    <menuitem id="menu_whatsapp_root_test" 
              name="WhatsApp Testing"
              sequence="11"/>
              
    <!-- Define a menu for WhatsApp chats -->
    <menuitem id="menu_whatsapp_chat" 
              name="WhatsApp Chats"
              parent="menu_whatsapp_root_test"
              action="action_whatsapp_chat"
              sequence="30"/>
    
              
    <menuitem id="menu_whatsapp_session_test"
              name="WhatsApp Test Sessions"
              parent="menu_whatsapp_root_test"
              action="action_whatsapp_session_test"
              sequence="20"/>
</odoo>