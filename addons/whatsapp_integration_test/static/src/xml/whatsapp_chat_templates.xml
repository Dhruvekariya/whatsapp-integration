<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- WhatsApp Dashboard Template -->
    <t t-name="WhatsAppDashboard">
        <div class="o_whatsapp_dashboard">
            <div class="o_whatsapp_dashboard_header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
                <h2 class="m-0">WhatsApp Chats</h2>
                <button class="btn btn-light o_whatsapp_refresh">
                    <i class="fa fa-refresh" title="Refresh"/> Refresh
                </button>
            </div>
            
            <div class="o_whatsapp_dashboard_content p-3">
                <div class="o_whatsapp_chat_list">
                    <!-- Chats will be rendered here -->
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
    
    <!-- WhatsApp Chat Item Template -->
    <t t-name="WhatsAppChatItem">
        <div class="o_whatsapp_chat_item" t-att-data-id="chat.id">
            <div class="o_whatsapp_chat_name">
                <t t-esc="chat.name"/>
            </div>
            <div t-if="chat.unread_count > 0" class="o_whatsapp_chat_unread badge badge-pill badge-success">
                <t t-esc="chat.unread_count"/>
            </div>
        </div>
    </t>
    
    <!-- WhatsApp Message Template -->
    <t t-name="WhatsAppMessage">
        <div t-att-class="'o_whatsapp_message ' + (message.direction === 'incoming' ? 'o_whatsapp_incoming' : 'o_whatsapp_outgoing')">
            <div class="o_whatsapp_message_content">
                <t t-esc="message.content"/>
            </div>
            <div class="o_whatsapp_message_meta">
                <t t-esc="moment(message.date).format('HH:mm')"/>
                <t t-if="message.direction === 'outgoing'">
                    <i t-att-class="'fa ' + getStatusIcon(message.state)" t-att-title="message.state"/>
                </t>
            </div>
        </div>
    </t>
</templates>